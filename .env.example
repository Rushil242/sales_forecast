# RetailIQ configuration. Copy to .env and edit; every value here is a default,
# so an empty .env is a valid configuration.

# ── application ───────────────────────────────────────────────────────────────
# RETAILIQ_ENVIRONMENT=development       # development | production | test
# RETAILIQ_LOG_LEVEL=INFO
# RETAILIQ_LOG_JSON=false                # true for one JSON object per line
# RETAILIQ_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── storage ───────────────────────────────────────────────────────────────────
# RETAILIQ_DATA_DIR=./data
# RETAILIQ_DATABASE_URL=sqlite:///./data/retailiq.db

# ── forecasting ───────────────────────────────────────────────────────────────
# Chronos-2 is the default: it is the only model here that accepts covariates.
# Chronos-Bolt is kept as the univariate control in the backtest.
# RETAILIQ_DEFAULT_MODEL=chronos-2
# RETAILIQ_CHRONOS2_MODEL_ID=amazon/chronos-2
# RETAILIQ_CHRONOS_ENABLED=true
# RETAILIQ_CHRONOS_MODEL_ID=amazon/chronos-bolt-small
#   Alternatives: chronos-bolt-base (better, ~800MB), chronos-bolt-tiny (faster)
# RETAILIQ_CHRONOS_DEVICE=auto           # auto | cpu | cuda | mps
# RETAILIQ_FORECAST_MAX_HORIZON=180

# Refuse to forecast below this many days of history rather than padding it.
# RETAILIQ_MIN_OBSERVATIONS=30
# Warn (but proceed) below this many.
# RETAILIQ_RECOMMENDED_OBSERVATIONS=120

# ── backtesting ───────────────────────────────────────────────────────────────
# RETAILIQ_BACKTEST_WINDOWS=5

# ── data connectors ───────────────────────────────────────────────────────────
# Encrypts stored OAuth tokens at rest. Any long random string. Without it the
# key is ephemeral and connections do not survive a restart.
# RETAILIQ_SECRET_KEY=

# These two must match what the platform sends the browser back to, and where
# the web app lives. OAuth compares the redirect URI byte for byte.
# RETAILIQ_PUBLIC_BASE_URL=http://localhost:8000
# RETAILIQ_APP_BASE_URL=http://localhost:5173
# RETAILIQ_CONNECTOR_SYNC_DAYS=730

# Shopify: free at partners.shopify.com, development stores cost nothing.
# Register this redirect URL in the app:
#   http://localhost:8000/api/v1/connect/shopify/callback
# RETAILIQ_SHOPIFY_API_KEY=
# RETAILIQ_SHOPIFY_API_SECRET=
# read_orders only exposes the last 60 days. read_all_orders (free to enable on a
# dev store) is needed for real history; the sync reports it if the window clips.
# RETAILIQ_SHOPIFY_SCOPES=read_orders,read_products

# Zoho: free at api-console.zoho.in. The data centre matters -- a token from
# accounts.zoho.in is rejected by zohoapis.com.
# RETAILIQ_ZOHO_CLIENT_ID=
# RETAILIQ_ZOHO_CLIENT_SECRET=
# RETAILIQ_ZOHO_REGION=in            # in | com | eu | au | jp | ca
# Zoho serves invoice line items one invoice at a time, so a first sync is bounded.
# RETAILIQ_ZOHO_MAX_INVOICES=600

# ── social intelligence ───────────────────────────────────────────────────────
# RETAILIQ_SOCIAL_ENABLED=true
# Sources that are blocked (pinterest) or need a key (reddit, instagram, x) stay
# enabled on purpose: the response then states what was tried and why it failed.
# RETAILIQ_SOCIAL_CONNECTORS=news,mastodon,hackernews,youtube,web,trends,reddit,pinterest,instagram,x
# RETAILIQ_SOCIAL_LOOKBACK_DAYS=30
# RETAILIQ_SOCIAL_CACHE_TTL_SECONDS=21600

# Reddit withdrew anonymous JSON access, so this connector needs free
# credentials. Create a "script" app at https://www.reddit.com/prefs/apps.
# Without them Reddit reports itself unavailable and the other sources carry on.
# RETAILIQ_REDDIT_CLIENT_ID=
# RETAILIQ_REDDIT_CLIENT_SECRET=

# ── open-web scraping (Scrapling) ─────────────────────────────────────────────
# Powers the YouTube and blogs/reviews connectors. Low volume by design: every
# request is throttled per domain and results are cached for the snapshot TTL.
# RETAILIQ_SCRAPING_ENABLED=true
# RETAILIQ_SCRAPING_TIMEOUT=25
#
# Pinterest is implemented but currently returns nothing: its search XHR answers
# 403 for anonymous clients even with session cookies and a CSRF header. The
# rendered-page fallback needs a browser binary:
#   .venv/bin/patchright install chromium
#
# Instagram and X have no anonymous search endpoint at all, so they run through
# Apify actors. Free monthly credit, no card. Without a token they report
# themselves unavailable and name this variable.
# RETAILIQ_APIFY_TOKEN=
# RETAILIQ_APIFY_INSTAGRAM_ACTOR=apify~instagram-hashtag-scraper
# RETAILIQ_APIFY_TWEET_ACTOR=apidojo~tweet-scraper

# ── sentiment ─────────────────────────────────────────────────────────────────
# Default is the Twitter/X-domain RoBERTa. FinBERT is available for comparison
# but scores 6/8 on the labelled consumer set versus 8/8 for the default --
# see backend/scripts/compare_sentiment_models.py.
# RETAILIQ_SENTIMENT_MODEL_ID=cardiffnlp/twitter-roberta-base-sentiment-latest

# ── plain-English briefs (Google AI Studio) ───────────────────────────────────
# Free, no card: aistudio.google.com/apikey. Without it the deterministic
# template renders instead and the UI shows a "Computed" badge.
# Every figure the model writes is checked against the measured data before it is
# shown; an unsupported number discards the whole brief.
# RETAILIQ_GOOGLE_API_KEY=
# RETAILIQ_GEMINI_MODEL=gemini-2.5-flash

# ── optional LLM narrative (social page, legacy path) ─────────────────────────
# Without a key the findings are composed deterministically from the measured
# aggregates, which is the default and cannot hallucinate figures.
# RETAILIQ_ANTHROPIC_API_KEY=
# RETAILIQ_LLM_MODEL=claude-sonnet-5

# ── sentiment fusion ──────────────────────────────────────────────────────────
# RETAILIQ_FUSION_ENABLED=true
# RETAILIQ_FUSION_MIN_OVERLAP_DAYS=45    # below this, a bounded prior is used
# RETAILIQ_FUSION_MAX_ADJUSTMENT=0.25    # hard cap on sentiment's influence
# RETAILIQ_FUSION_PRIOR_ELASTICITY=0.08
